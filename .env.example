# Platform
PYWORKSPACE_MASTER_KEY=change-me-in-production
PYWORKSPACE_ENV=dev
PYWORKSPACE_VERSION=1.0.0

# Database (platform metadata)
DATABASE_URL=postgresql+asyncpg://pyworkspace:pyworkspace@localhost:5432/pyworkspace
DATABASE_POOL_SIZE=20

# Redis (platform cache + task queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Kubernetes
K8S_IN_CLUSTER=false
K8S_KUBECONFIG_PATH=~/.kube/config
K8S_WORKSPACE_NAMESPACE_PREFIX=pyws
K8S_DEFAULT_STORAGE_CLASS=standard
K8S_FIRECRACKER_RUNTIME=kata-containers

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token
VAULT_WORKSPACE_PATH=secret/workspaces

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_SNAPSHOTS=pyworkspace-snapshots

# Resource defaults
DEFAULT_CPU_LIMIT=4
DEFAULT_MEMORY_LIMIT=8Gi
DEFAULT_DISK_LIMIT=50Gi
DEFAULT_WORKSPACE_TTL_HOURS=24
MAX_SERVICES_PER_WORKSPACE=20

# Networking
WORKSPACE_DNS_DOMAIN=workspace.local
PORT_RANGE_START=30000
PORT_RANGE_END=40000

# Agent
PYOZ_IMAGE=pyworkspace/pyoz-agent:latest
PYOZ_CPU=2
PYOZ_MEMORY=4Gi

# PyGate
PYGATE_URL=
PYGATE_API_KEY=

# LocalStack
LOCALSTACK_IMAGE=localstack/localstack-pro:latest
LOCALSTACK_PRO_KEY=
DEFAULT_AWS_REGION=us-east-1

# Observability
OTEL_ENDPOINT=
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO

# Postgres (docker-compose)
POSTGRES_PASSWORD=pyworkspace
